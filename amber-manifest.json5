{
  manifest_version: "0.1.0",

  config_schema: {
    type: "object",
    properties: {
      open_ai_api_key: { type: "string", secret: true }
    },
    required: ["open_ai_api_key"],
    additionalProperties: false
  },

  program: {
    entrypoint: "argusbot",

    env: {
      OPENAI_API_KEY: "${config.open_ai_api_key}"
    },

    network: {
      endpoints: [
        { name: "a2a_endpoint", port: 9010 }
      ]
    }
  },

  provides: {
    a2a: { kind: "a2a", endpoint: "a2a_endpoint" }
  },

  exports: {
    a2a: "a2a"
  }
}